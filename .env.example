# Copy this file to .env.local and fill in values to enable optional features.
# The app runs fully without any of these.

# Optional: enables the Claude-powered "full AI" chat mode.
# Read only on the server; never sent to the browser.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used in AI mode (defaults to claude-opus-5-5).
# ANTHROPIC_MODEL=
